# Copy to .env for local development: cp .env.example .env
# Values below are for local dev only. Production values are never committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (Socket.IO handshake + CSRF checks).
APP_ORIGIN=http://localhost:5173
# false = trust no proxy. Otherwise a comma-separated list of proxy IPs/CIDRs allowed to set X-Forwarded-For
# (docker-compose.yml sets Caddy's fixed IP). Never `true`: that would let any client forge its IP.
TRUST_PROXY=false

# --- Postgres (docker-compose service `postgres`) ---
POSTGRES_USER=hearth
POSTGRES_PASSWORD=hearth
POSTGRES_DB=hearth
DATABASE_URL=postgres://hearth:hearth@localhost:5432/hearth
DATABASE_URL_UNIT=postgres://hearth:hearth@localhost:5432/hearth_unit
DATABASE_URL_E2E=postgres://hearth:hearth@localhost:5432/hearth_e2e
MIGRATE_ON_START=false

# --- Accounts ---
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
MAX_USERS=25

# --- Uploads ---
# Relative paths resolve against the repo root.
UPLOAD_DIR=./data/uploads
# How often unattached uploads (>24 h), stale temp files (>1 h) and orphan files are cleaned up; 0 disables.
UPLOAD_GC_INTERVAL_MINUTES=60
# Uploads are refused (507 STORAGE_FULL) when the upload filesystem has less free space than this.
UPLOAD_MIN_FREE_MB=2048

# --- LiveKit (docker-compose service `livekit`) ---
# Server -> LiveKit API (http). Browser -> LiveKit signaling (ws/wss).
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# Must be at least 32 characters. Dev-only placeholder; generate a real one for production.
LIVEKIT_API_SECRET=dev-only-secret-change-me-0123456789abcdef
# Read by the LiveKit container: "<key>: <secret>" (must match the two values above).
LIVEKIT_KEYS=devkey: dev-only-secret-change-me-0123456789abcdef

# --- Test mode (never enable in production) ---
HEARTH_TEST_MODE=false
HEARTH_TEST_TOKEN=

# --- Production only (phase 9) ---
HEARTH_DOMAIN=
