{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // e2e is not a workspace package, so `@hearth/shared` is mapped to its source here.
    // Only `import type` from it: Playwright's loader does not resolve this mapping at runtime.
    "paths": {
      "@hearth/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
