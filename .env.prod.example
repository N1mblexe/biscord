# Shape of .env.prod for docker-compose.prod.yml. PLACEHOLDERS ONLY: do not copy this file to .env.prod.
# Generate the real one on the server with: infra/scripts/gen-secrets.sh --domain <name>.duckdns.org --email <you>
# Used as-is only to validate the compose file:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod.example config --quiet

HEARTH_DOMAIN=example.duckdns.org
ACME_EMAIL=admin@example.com

POSTGRES_USER=hearth
POSTGRES_PASSWORD=placeholder-generated-by-gen-secrets-sh
POSTGRES_DB=hearth

LIVEKIT_API_KEY=hearth-prod
LIVEKIT_API_SECRET=placeholder-generated-by-gen-secrets-sh-at-least-32-chars
# Optional: the VM's reserved public IP (skips STUN discovery in LiveKit). Empty = discover via STUN.
NODE_IP=

LOG_LEVEL=info
SESSION_TTL_DAYS=30
MAX_USERS=25
UPLOAD_GC_INTERVAL_MINUTES=60
UPLOAD_MIN_FREE_MB=2048
VOICE_RECONCILE_MS=60000

BACKUP_AT=03:30
BACKUP_KEEP=7
BACKUP_KEEP_EXTRA=3
BACKUP_MIN_FREE_MB=2048
