# Production (docker-compose.prod.yml): automatic Let's Encrypt certificates for {$HEARTH_DOMAIN} and lk.{$HEARTH_DOMAIN}.
# HEARTH_DOMAIN and ACME_EMAIL come from .env.prod. Caddy runs unprivileged and listens on 80/443 (tcp) + 443 (udp, HTTP/3).
# Loaded from the mounted infra/caddy directory (`caddy run --config /etc/hearth-caddy/Caddyfile.prod`); after editing it,
# `hc up -d --force-recreate caddy` (deploy.sh does this automatically when infra/ changed).
{
	admin off
	email {$ACME_EMAIL}
}

{$HEARTH_DOMAIN} {
	# Security headers (B.7b / PLAN §6). One `?` directive per header: each is set only when the upstream
	# response doesn't already carry it (e.g. the server's stricter per-file CSP on attachment downloads).
	header ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss://lk.{$HEARTH_DOMAIN} https://lk.{$HEARTH_DOMAIN}; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "no-referrer"
	header ?Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), speaker-selection=(self), geolocation=()"
	header ?Cross-Origin-Opener-Policy "same-origin"
	# HTTPS only from now on; one year, no includeSubDomains/preload (a DuckDNS name is not ours to preload).
	header ?Strict-Transport-Security "max-age=31536000"
	header -Server

	request_body {
		max_size 26MiB
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /socket.io/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# LiveKit signalling (wss) and its HTTP validate/reconnect probes. LiveKit uses host networking and listens on the
# compose network gateway, which docker-compose.prod.yml maps to host.docker.internal. WebSockets are proxied as is.
lk.{$HEARTH_DOMAIN} {
	header ?Strict-Transport-Security "max-age=31536000"
	header -Server
	reverse_proxy host.docker.internal:7880
}

# Container healthcheck only: loopback inside the container, not published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond "ok" 200
}
