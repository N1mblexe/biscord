# Local full stack (docker compose up --build): plain HTTP on :8080.
# Production config with HTTPS lives in Caddyfile.prod (phase 9).
{
	admin off
}

:8080 {
	# Security headers (B.7b / PLAN §6). One `?` directive per header: each is set only when the upstream
	# response doesn't already carry it (e.g. the server's stricter per-file CSP on attachment downloads).
	header ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ws://localhost:7880 http://localhost:7880; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "no-referrer"
	header ?Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
	header ?Cross-Origin-Opener-Policy "same-origin"
	header -Server

	request_body {
		max_size 26MiB
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /socket.io/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
