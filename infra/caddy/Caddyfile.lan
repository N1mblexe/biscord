# LAN test profile (docker-compose.lan.yml). HTTPS with Caddy's own local CA, for a trusted home network only.
# Clients connecting to a bare IP send no SNI, so default_sni makes Caddy pick the certificate for LAN_IP.
{
	admin off
	local_certs
	skip_install_trust
	default_sni {$LAN_IP}
}

https://{$LAN_IP}:8443 {
	tls internal

	# Security headers (B.7b / PLAN §6). `?` sets a header only when the upstream didn't, so the server's
	# stricter per-file CSP on attachment downloads is kept.
	header {
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss://{$LAN_IP}:7443; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		?Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		?Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 26MiB
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /socket.io/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# LiveKit signaling over wss.
https://{$LAN_IP}:7443 {
	tls internal
	reverse_proxy livekit:7880
}
