{
  "name": "@hearth/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=hearth-src --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=hearth-src --env-file-if-exists=../../.env src/db/migrate.ts",
    "bootstrap": "tsx --conditions=hearth-src --env-file-if-exists=../../.env src/cli/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@hearth/shared": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "livekit-server-sdk": "2.19.1",
    "pg": "8.23.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
