{
  "name": "hearth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hearth/server --filter @hearth/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "infra:up": "docker compose up -d --wait postgres livekit",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @hearth/server db:generate",
    "db:migrate": "pnpm --filter @hearth/server db:migrate",
    "lan:up": "infra/scripts/lan-up.sh",
    "lan:down": "infra/scripts/lan-down.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
